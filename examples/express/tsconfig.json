{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",

    "baseUrl": ".",
    "paths": {
      "@varsilias/corelens": ["../../src/index.ts"],
      "@varsilias/corelens/adapter": ["../../src/adapter/index.ts"]
    },

    "outDir": "./dist"
  },
  "include": ["**/*.ts"]
}
