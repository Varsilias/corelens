{
  "name": "example-hono",
  "version": "1.0.0",
  "description": "Corelens Hono gateway example with outbound client spans",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --watch src --ext ts --exec 'ts-node' src/index.ts",
    "dev": "nodemon --watch src --watch ../../src --ext ts --exec ts-node --require tsconfig-paths/register src/index.ts",
    "typecheck": "tsc --noEmit",
    "bench": "autocannon -c 50 -d 20 http://localhost:3200/api/products/CORELENS-TEE/recommendations"
  },
  "keywords": [
    "corelens",
    "observability",
    "telemetry",
    "open-telemetry",
    "hono"
  ],
  "author": "Daniel Okoronkwo <danielokoronkwo90@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@varsilias/corelens": "file:../../",
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
