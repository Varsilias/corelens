{
  "name": "example-fastify",
  "version": "1.0.0",
  "description": "Corelens Fastify todo API example",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../src --ext ts --exec ts-node --require tsconfig-paths/register src/index.ts",
    "start": "nodemon --watch src --ext ts --exec 'ts-node' src/index.ts",
    "typecheck": "tsc --noEmit",
    "bench": "autocannon -c 100 -d 20 http://localhost:3100/api/todos"
  },
  "keywords": [
    "corelens",
    "observability",
    "telemetry",
    "open-telemetry",
    "fastify"
  ],
  "author": "Daniel Okoronkwo <danielokoronkwo90@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@varsilias/corelens": "file:../../",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
