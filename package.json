{
  "name": "@varsilias/corelens",
  "version": "1.0.0",
  "description": "Corelens is an opinionated, high-performance observability SDK for Node.js that provides logs, metrics, and traces with minimal setup, built on top of OpenTelemetry but hiding its complexity.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opentelemetry",
    "logs",
    "metrics",
    "tracing",
    "monitoring",
    "microservices",
    "otel",
    "observability"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "bench": "npm run bench:logger && npm run bench:metrics && npm run bench:traces && npm run bench:frameworks && npm run bench:exporter-failure",
    "bench:logger": "npm run build && node bench/logger-comparison.js",
    "bench:metrics": "npm run build && node bench/metrics.js",
    "bench:traces": "npm run build && node bench/traces.js",
    "bench:frameworks": "npm run build && node bench/frameworks.js",
    "bench:exporter-failure": "npm run build && node bench/exporter-failure.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "publish:ci": "npm publish --access restricted",
    "dev": "ts-node src/tester"
  },
  "author": "Daniel Okoronkwo <danielokoronkwo90@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Varsilias/corelens"
  },
  "bugs": {
    "url": "https://github.com/Varsilias/corelens/issues"
  },
  "homepage": "https://github.com/Varsilias/corelens#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "hono": "^4.12.15",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "pino": "^10.3.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "hono": "^4.12.15"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "^10.5.0",
    "test-exclude": {
      "glob": "^10.5.0"
    },
    "brace-expansion": "^2.0.3"
  }
}
