{
  "name": "@varsilias/corelens",
  "version": "1.1.2",
  "description": "Corelens is an opinionated, high-performance observability SDK for Node.js application that provides logs, metrics, and traces with minimal setup, built with first class support for OpenTelemetry API specification.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "require": "./dist/adapter/index.js",
      "default": "./dist/adapter/index.js"
    },
    "./adapter/nest": {
      "types": "./dist/adapter/nest/index.d.ts",
      "require": "./dist/adapter/nest/index.js",
      "default": "./dist/adapter/nest/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./exporters": {
      "types": "./dist/exporters/index.d.ts",
      "require": "./dist/exporters/index.js",
      "default": "./dist/exporters/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "require": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "opentelemetry",
    "logs",
    "metrics",
    "tracing",
    "monitoring",
    "microservices",
    "otel",
    "observability"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "bench": "npm run bench:logger && npm run bench:metrics && npm run bench:traces && npm run bench:frameworks && npm run bench:exporter-failure",
    "bench:logger": "npm run build && node bench/logger-comparison.js",
    "bench:metrics": "npm run build && node bench/metrics.js",
    "bench:traces": "npm run build && node bench/traces.js",
    "bench:frameworks": "npm run build && node bench/frameworks.js",
    "bench:exporter-failure": "npm run build && node bench/exporter-failure.js",
    "release:prepare": "node scripts/release-prepare.js",
    "release:check": "node scripts/release-check.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "prepublishOnly": "npm run build",
    "prepare": "node scripts/prepare-husky.js",
    "publish:ci": "npm publish --access public --provenance",
    "publish:dry-run": "npm publish --dry-run",
    "dev": "ts-node src/tester"
  },
  "author": "Daniel Okoronkwo <danielokoronkwo90@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Varsilias/corelens.git"
  },
  "bugs": {
    "url": "https://github.com/Varsilias/corelens/issues"
  },
  "homepage": "https://github.com/Varsilias/corelens#readme",
  "devDependencies": {
    "@nestjs/common": "^11.1.21",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "hono": "^4.12.15",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "pino": "^10.3.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "express": ">=4 <6",
    "fastify": ">=4 <6",
    "hono": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "^10.5.0",
    "test-exclude": {
      "glob": "^7.2.3"
    },
    "brace-expansion": "^2.0.3"
  }
}
